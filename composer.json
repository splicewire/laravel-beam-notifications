{
    "name": "splicewire/laravel-beam-notifications",
    "description": "The notify capability of the schemastud beam family: a beam can notify. Owns the x-beam-notify keyword and the submission -> notify wiring, synthesizing one generic BeamNotification from the keyword (overridable by a host FQCN) to typed recipients (to / to_roles / to_teams). Consumes rushing/laravel-notification-status for delivery tracking with zero coupling and reuses Laravel's channels + Notifiable; the central relay is a satellite-registered custom channel, not shipped here.",
    "keywords": [
        "laravel",
        "schemastud",
        "beam",
        "notifications",
        "notify",
        "submissions"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "rushing/laravel-notification-status": "*",
        "splicewire/laravel-beam": "*",
        "rushing/laravel-schema-convergence": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "spatie/laravel-medialibrary": "^11.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "suggest": {
        "splicewire/laravel-beam-accounts": "Resolves the to_roles / to_teams recipient keys (roles enum + team membership). Without it, only the address-only `to:` key works; to_roles/to_teams throw a clear boot/first-send error."
    },
    "autoload": {
        "psr-4": {
            "Splicewire\\Beam\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Splicewire\\Beam\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Splicewire\\Beam\\Notifications\\BeamNotificationsServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "@php -d memory_limit=512M vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-notification-status.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-schema-convergence.git"
        },
        {
            "type": "git",
            "url": "https://github.com/splicewire/laravel-beam.git"
        }
    ]
}
